#!/usr/bin/env python3
"""buildq — machine-wide queue for heavy Xcode builds, shared by all worktrees and agents.

Only one queued command runs at a time. Waiting builds go by priority (major > normal > minor), FIFO
within one priority; a running build is never preempted. Simulators are per-worktree clones, so the slot is held
for the build only; installing and checking the app happens outside the queue.
"""

__version__ = "0.2.0"

import argparse
import fcntl
import hashlib
import itertools
import json
import os
import plistlib
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path(os.environ.get("BUILDQ_HOME", Path.home() / ".buildq"))
QUEUE = HOME / "queue"
LOGS = HOME / "logs"
RUN_LOCK = HOME / "run.lock"
SIM_LOCK = HOME / "sim.lock"
HISTORY = HOME / "history.log"
EVENTS = HOME / "events.log"
SIM_SOURCE_FILE = HOME / "sim_source"
CONFIG = HOME / "config.json"
BASE_SIM = "buildq-base"
SIM_PREFIX = "wt-"
EX_TIMEOUT = 75
KEEP_LOGS = 50
ROTATE_BYTES = 5 << 20
ORPHAN_GRACE = float(os.environ.get("BUILDQ_ORPHAN_GRACE", 20))
PRIORITIES = ("minor", "normal", "major")
DEFAULT_PRIORITY = "normal"


def log(msg):
    print(f"[buildq] {msg}", file=sys.stderr, flush=True)


def append_jsonl(path, rec):
    """Append one record; past ROTATE_BYTES the file moves to <name>.1 (one generation is kept)."""
    HOME.mkdir(parents=True, exist_ok=True)
    try:
        if path.stat().st_size > ROTATE_BYTES:
            os.replace(path, path.with_name(path.name + ".1"))
    except FileNotFoundError:
        pass
    with open(path, "a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")


def event(kind, **fields):
    """Append-only JSONL journal for post-mortems; never let logging break a build."""
    try:
        append_jsonl(EVENTS, {"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "kind": kind, "pid": os.getpid(),
                              **fields})
    except OSError:
        pass


def load_config():
    try:
        return json.loads(CONFIG.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as e:
        log(f"ignoring {CONFIG}: {e}")
        return {}


def prune_logs():
    logs = sorted(LOGS.glob("*.log"), key=lambda p: p.stat().st_mtime)
    for p in logs[:-KEEP_LOGS]:
        p.unlink(missing_ok=True)


def fmt_dur(sec):
    sec = int(sec)
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m{sec % 60:02d}s"
    return f"{sec // 3600}h{sec % 3600 // 60:02d}m"


def proc_start(pid):
    r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip() or None


def alive(pid, start=None):
    """pid + its start time, so a recycled pid is not mistaken for the original holder."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return start is None or proc_start(pid) == start


def group_alive(pgid):
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def worktree_root():
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else os.getcwd()


def git_branch():
    r = subprocess.run(["git", "branch", "--show-current"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def ensure_dirs():
    QUEUE.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(parents=True, exist_ok=True)


def write_ticket(t):
    path = QUEUE / f"{t['id']}.json"
    tmp = QUEUE / f".{t['id']}.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(t))
    os.replace(tmp, path)


def enqueue(ticket):
    """Assign a strictly increasing sequence number and publish the ticket atomically under one lock,
    so the queue order is exactly the order of arrival."""
    fd = os.open(HOME / "seq", os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        n = int(os.read(fd, 32) or 0) + 1
        os.lseek(fd, 0, os.SEEK_SET)
        os.ftruncate(fd, 0)
        os.write(fd, str(n).encode())
        ticket["seq"] = n
        ticket["id"] = f"{n:08d}-{ticket['pid']}"
        write_ticket(ticket)
    finally:
        os.close(fd)


def priority_rank(t):
    p = t.get("priority", DEFAULT_PRIORITY)
    return PRIORITIES.index(p) if p in PRIORITIES else PRIORITIES.index(DEFAULT_PRIORITY)


def load_tickets():
    """Queue order: the running build first, then waiting ones by priority, FIFO within a priority."""
    out = []
    for p in QUEUE.glob("*.json"):
        try:
            out.append(json.loads(p.read_text()))
        except (OSError, json.JSONDecodeError):
            continue
    out.sort(key=lambda t: (t["state"] == "waiting", -priority_rank(t), t.get("seq", 0), t["enqueued_ns"]))
    return out


def resolve_priority(explicit, label, worktree, branch, config):
    """--priority, then $BUILDQ_PRIORITY, then the first matching config rule, then the config default.
    A rule matches when all its conditions hold: `env` (variable is set and non-empty), and regexes
    `label`, `worktree`, `branch`."""
    for p, source in ((explicit, "--priority"), (os.environ.get("BUILDQ_PRIORITY"), "BUILDQ_PRIORITY")):
        if p:
            if p in PRIORITIES:
                return p
            log(f"ignoring {source}={p!r}: expected one of {', '.join(PRIORITIES)}")
    conf = config.get("priority", {})
    for rule in conf.get("rules", []):
        try:
            if rule.get("priority") in PRIORITIES and all((
                    not rule.get("env") or os.environ.get(rule["env"]),
                    not rule.get("label") or re.search(rule["label"], label),
                    not rule.get("worktree") or re.search(rule["worktree"], worktree),
                    not rule.get("branch") or re.search(rule["branch"], branch))):
                return rule["priority"]
        except re.error as e:
            log(f"bad priority rule {rule!r} in {CONFIG}: {e}")
    default = conf.get("default", DEFAULT_PRIORITY)
    return default if default in PRIORITIES else DEFAULT_PRIORITY


def reap():
    """Drop tickets of dead holders. If the holder was SIGKILLed mid-build, its build keeps the slot
    (it inherited the lock fd) until we stop it: SIGTERM, then SIGKILL after ORPHAN_GRACE seconds."""
    for t in load_tickets():
        if alive(t["pid"], t.get("pid_start")):
            continue
        pgid = t.get("child_pgid")
        if pgid and group_alive(pgid):
            now = time.time()
            if t["state"] != "orphan":
                t.update(state="orphan", orphan_since=now)
                write_ticket(t)
                os.killpg(pgid, signal.SIGTERM)
                event("orphan_term", ticket=t["id"], holder_pid=t["pid"], pgid=pgid,
                      worktree=t["worktree"], label=t["label"])
            elif now - t["orphan_since"] > ORPHAN_GRACE and not t.get("orphan_killed"):
                t["orphan_killed"] = True
                write_ticket(t)
                os.killpg(pgid, signal.SIGKILL)
                event("orphan_kill", ticket=t["id"], pgid=pgid, worktree=t["worktree"], label=t["label"])
            continue
        (QUEUE / f"{t['id']}.json").unlink(missing_ok=True)
        event("reaped", ticket=t["id"], holder_pid=t["pid"], state=t["state"], worktree=t["worktree"],
              label=t["label"])


def describe(t):
    br = f" [{t['branch']}]" if t.get("branch") else ""
    pr = f" ({t['priority']})" if t.get("priority", DEFAULT_PRIORITY) != DEFAULT_PRIORITY else ""
    return f"{Path(t['worktree']).name}{br} «{t['label']}»{pr}"


# ---------- run ----------

def cmd_run(args):
    cmd = args.cmd[1:] if args.cmd and args.cmd[0] == "--" else args.cmd
    if not cmd:
        sys.exit("buildq run: missing command, usage: buildq run [--label L] [--log FILE] -- <cmd...>")
    if args.base and not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}", args.base):
        sys.exit("buildq run: --base needs a name of 1–64 letters, digits, _, . or - (start with a letter/digit)")
    if not args.base and (args.prepare or args.include_ignored or args.products_to or args.no_dsym):
        sys.exit("buildq run: --prepare, --include-ignored, --products-to and --no-dsym require --base")
    if os.environ.get("BUILDQ_BASE_DIR"):
        sys.exit("buildq run: already inside a buildq base; run the command directly to avoid a nested queue")
    ensure_dirs()
    label = args.label or " ".join(cmd)[:80]
    worktree, branch = worktree_root(), git_branch()
    ticket = {
        "enqueued_ns": time.time_ns(),
        "pid": os.getpid(),
        "pid_start": proc_start(os.getpid()),
        "worktree": worktree,
        "branch": branch,
        "label": label,
        "priority": resolve_priority(args.priority, label, worktree, branch, load_config()),
        "cmd": shlex.join(cmd)[:500],
        "log": str(Path(args.log).absolute()) if args.log else None,
        "state": "waiting",
    }
    if args.base:
        ticket["base"] = args.base
    enqueue(ticket)
    ticket["full_log"] = str(LOGS / f"{ticket['id']}.log")
    write_ticket(ticket)
    ticket_path = QUEUE / f"{ticket['id']}.json"
    lock_fd = os.open(RUN_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    state = {"child": None, "holding": False}

    def cleanup():
        ticket_path.unlink(missing_ok=True)
        if state["holding"]:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            state["holding"] = False

    def on_signal(signum, _frame):
        child = state["child"]
        if child and child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
                child.wait(timeout=15)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        cleanup()
        event("interrupted", ticket=ticket["id"], signal=signum, state=ticket["state"],
              worktree=ticket["worktree"], label=label, full_log=ticket["full_log"])
        log(f"interrupted by signal {signum}, slot released")
        sys.exit(128 + signum)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, on_signal)

    queued = load_tickets()
    event("enqueued", ticket=ticket["id"], worktree=ticket["worktree"], branch=ticket["branch"], label=label,
          priority=ticket["priority"], cmd=ticket["cmd"],
          ahead=[describe(t) for t in itertools.takewhile(lambda t: t["id"] != ticket["id"], queued)])
    start_wait = time.time()
    last_report, last_pos = 0.0, None
    while True:
        reap()
        tickets = load_tickets()
        ids = [t["id"] for t in tickets]
        if ticket["id"] not in ids:
            write_ticket(ticket)
            continue
        pos = ids.index(ticket["id"])
        # `buildq priority` (or the menu bar app) may change it while we wait.
        ticket["priority"] = tickets[pos].get("priority", ticket["priority"])
        if pos == 0:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                state["holding"] = True
                break
            except BlockingIOError:
                pass
        now = time.time()
        waited = now - start_wait
        if pos != last_pos or now - last_report >= args.report_every:
            running = [t for t in tickets if t["state"] in ("running", "orphan")]
            cur = (f"{running[0]['state']}: {describe(running[0])} for {fmt_dur(now - running[0]['started_at'])}"
                   if running else "slot is being handed over")
            log(f"waiting: position {pos + 1} of {len(tickets)} (waited {fmt_dur(waited)}); {cur}")
            last_report, last_pos = now, pos
        if args.max_wait and waited > args.max_wait * 60:
            ahead = ", ".join(describe(t) for t in tickets[:pos])
            log(f"gave up after {fmt_dur(waited)} in queue; ahead: {ahead}. "
                f"Check `buildq status`, retry later or ask the user.")
            event("timeout", ticket=ticket["id"], worktree=ticket["worktree"], label=label,
                  waited=round(waited), ahead=ahead)
            cleanup()
            sys.exit(EX_TIMEOUT)
        time.sleep(2)

    waited = time.time() - start_wait
    ticket.update(state="running", started_at=time.time())
    write_ticket(ticket)
    log(f"slot acquired after {fmt_dur(waited)}: {label} (log: {ticket['log'] or ticket['full_log']})")
    event("acquired", ticket=ticket["id"], worktree=ticket["worktree"], label=label, waited=round(waited),
          load=os.getloadavg()[0], full_log=ticket["full_log"])

    # Full output always lands in ~/.buildq/logs; --log is a symlink to it for the caller.
    if ticket["log"]:
        Path(ticket["log"]).parent.mkdir(parents=True, exist_ok=True)
        Path(ticket["log"]).unlink(missing_ok=True)
        os.symlink(ticket["full_log"], ticket["log"])
    passthrough = not (ticket["log"] or args.quiet or args.json)
    child_env = None
    if args.base:
        settings = {"name": args.base, "origin": str(Path(worktree).resolve()),
                    "cwd": str(Path.cwd().resolve()), "prepare": args.prepare,
                    "include_ignored": args.include_ignored,
                    "products_to": str(Path(args.products_to).absolute()) if args.products_to else None,
                    "dsym": not args.no_dsym}
        cmd = [sys.executable, str(Path(__file__).resolve()), "_base-run", json.dumps(settings), *cmd]
        child_env = {**os.environ, "BUILDQ_BASE_LOCK_FD": str(lock_fd)}
    # The build inherits the locked fd: if this wrapper is SIGKILLed, the slot stays taken until the
    # orphaned build is really gone, so two builds never overlap.
    state["child"] = subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, pass_fds=(lock_fd,), env=child_env)
    ticket["child_pgid"] = state["child"].pid
    write_ticket(ticket)
    with open(ticket["full_log"], "wb") as f:
        f.write(f"# buildq {ticket['id']} {ticket['worktree']} [{ticket['branch']}]\n# $ {ticket['cmd']}\n".encode())
        for chunk in iter(lambda: state["child"].stdout.read1(65536), b""):
            f.write(chunk)
            if passthrough:
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
    rc = state["child"].wait()
    ran = time.time() - ticket["started_at"]
    cleanup()
    append_jsonl(HISTORY, {"id": ticket["id"], "worktree": ticket["worktree"], "branch": ticket["branch"],
                           "label": label, "waited": round(waited), "ran": round(ran), "exit": rc,
                           "full_log": ticket["full_log"], "finished_at": time.strftime("%Y-%m-%d %H:%M:%S"),
                           "base": args.base})
    event("finished", ticket=ticket["id"], worktree=ticket["worktree"], label=label, exit=rc,
          waited=round(waited), ran=round(ran), full_log=ticket["full_log"])
    prune_logs()
    log(f"finished in {fmt_dur(ran)} with exit {rc}; slot released")
    if not passthrough and not args.json:
        log(f"full output: {ticket['log'] or ticket['full_log']} (`buildq log {ticket['id']} --tail 100`)")
    if args.json:
        print(json.dumps({"id": ticket["id"], "exit": rc, "waited": round(waited), "ran": round(ran),
                          "log": ticket["full_log"], "errors": parse_errors(ticket["full_log"])[:ERRORS_LIMIT]
                          if rc != 0 else [],
                          **({"base": args.base, "products": settings["products_to"] if rc == 0 else None}
                             if args.base else {})}, ensure_ascii=False))
    elif rc != 0 and not passthrough:
        print_errors(ticket["full_log"])
    sys.exit(rc)


# ---------- reusable build bases (always run as a child of the queue holder) ----------

BASE_SIGNAL = 0


class BaseCancelled(Exception):
    pass


def base_check_cancel():
    if BASE_SIGNAL:
        raise BaseCancelled()


def base_on_signal(signum, _frame):
    # The outer wrapper signals our whole process group. Wait for the active child to exit:
    # otherwise the wrapper could finish waiting and unlock while a grandchild still compiles.
    global BASE_SIGNAL
    BASE_SIGNAL = signum


def base_root():
    configured = load_config().get("bases", {}).get("root", HOME / "bases")
    return Path(os.environ.get("BUILDQ_BASE_ROOT", configured)).expanduser().resolve()


def base_env():
    # Git hooks may export these: do not let them redirect git in the mirrored checkout.
    env = dict(os.environ)
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR", "GIT_PREFIX",
                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
        env.pop(key, None)
    return env


def base_exec(cmd, cwd, env, capture=False):
    # All descendants keep the queue lock, including git, preparation, compiler and dsymutil.
    fd = int(os.environ["BUILDQ_BASE_LOCK_FD"])
    base_check_cancel()
    result = subprocess.run(cmd, cwd=cwd, env=env, pass_fds=(fd,),
                            stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.PIPE if capture else None)
    base_check_cancel()
    return result


def base_git(cwd, env, *cmd):
    result = base_exec(["git", *cmd], cwd, {**env, "GIT_LFS_SKIP_SMUDGE": "1"}, capture=True)
    if result.returncode:
        raise ValueError(f"git {cmd[0]} failed: {result.stderr.decode(errors='replace').strip()}")
    return result.stdout


def base_write_state(path, data):
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=True))
    os.replace(tmp, path)


def base_fingerprint(path):
    if path.is_symlink():
        return ("link", os.readlink(path))
    if not path.is_file():
        return None
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    return ("file", digest.hexdigest(), stat.S_IMODE(path.stat().st_mode))


def base_path(src, rel):
    """Never traverse a symlink a previous build left in a source directory."""
    path = src / rel
    if Path(rel).is_absolute() or ".." in Path(rel).parts or ".git" in Path(rel).parts:
        raise ValueError(f"unsafe source path: {rel}")
    for parent in path.relative_to(src).parents:
        if (src / parent).is_symlink():
            raise ValueError(f"source directory is a symlink in the base: {parent}")
    return path


def base_sync(origin, src, state_path, state, head, env, include_ignored):
    entries = base_git(origin, env, "ls-files", "--stage", "-z").split(b"\0")
    if any(entry.startswith(b"160000 ") for entry in entries):
        raise ValueError("submodules are not supported by --base yet")
    names = base_git(origin, env, "ls-files", "-z", "--cached", "--others", "--exclude-standard").split(b"\0")
    if include_ignored:
        names += base_git(origin, env, "ls-files", "-z", "--others", "--ignored", "--exclude-standard",
                          "--", *include_ignored).split(b"\0")
    files = set()
    for name in filter(None, names):
        rel = os.fsdecode(name)
        path = origin / rel
        if path.is_symlink() or path.is_file():
            files.add(rel)
        elif path.is_dir():
            raise ValueError(f"submodules are not supported by --base yet: {rel}")
    previous = set(state.get("files", []))
    # Journal the union before any writes: an interrupted sync can be repaired on the next run.
    state["files"] = sorted(previous | files)
    base_write_state(state_path, state)
    changed = removed = 0
    for rel in sorted(previous - files, key=lambda p: len(Path(p).parts), reverse=True):
        path = base_path(src, rel)
        if path.is_symlink() or path.is_file():
            path.unlink()
            removed += 1
            parent = path.parent
            while parent != src:
                try:
                    parent.rmdir()
                except OSError:
                    break
                parent = parent.parent
    for rel in sorted(files):
        source, target = origin / rel, base_path(src, rel)
        signature = base_fingerprint(source)
        if signature is None:
            raise ValueError(f"source changed during sync: {source}; retry the build")
        if source.is_symlink():
            resolved = source.resolve()
            try:
                internal = resolved.relative_to(origin)
            except ValueError:
                raise ValueError(f"source symlink points outside the repository: {source}") from None
            link = os.readlink(source)
            if os.path.isabs(link):
                signature = ("link", str(src / internal))
        if target.is_dir() and not target.is_symlink():
            # Never recursively delete generated data merely to make a source path fit.
            target.rmdir()
        if signature == base_fingerprint(target):
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        copy_fd, copy_name = tempfile.mkstemp(prefix=".buildq-sync-", dir=target.parent)
        os.close(copy_fd)
        temporary = Path(copy_name)
        try:
            if signature[0] == "link":
                temporary.unlink()
                temporary.symlink_to(signature[1])
            else:
                shutil.copy2(source, temporary)
                if base_fingerprint(temporary) != signature:
                    raise ValueError(f"source changed during sync: {source}; retry the build")
                # A changed file must look changed even if its source timestamp was restored.
                os.utime(temporary, ns=(time.time_ns(), time.time_ns()))
            os.replace(temporary, target)
        finally:
            temporary.unlink(missing_ok=True)
        changed += 1
    # Keep git-based version scripts accurate, without checkout rewriting source timestamps.
    base_git(src, env, "update-ref", "--no-deref", "HEAD", head)
    base_git(src, env, "read-tree", head)
    state.update(files=sorted(files), head=head, worktree=str(origin), updated=time.time())
    base_write_state(state_path, state)
    return changed, removed


def base_generated_times(src):
    """Tuist/XcodeGen may rewrite identical project files; preserve their incremental timestamps."""
    times = {}
    for directory, dirs, files in os.walk(src, followlinks=False):
        dirs[:] = [d for d in dirs if d not in (".git", ".build", "node_modules", "DerivedData", ".tuist")
                   and not (Path(directory) / d).is_symlink()]
        parts = Path(directory).relative_to(src).parts
        if not any(p.endswith((".xcodeproj", ".xcworkspace")) or p == "Derived" for p in parts):
            continue
        for name in files:
            path = Path(directory) / name
            if path.is_file() and not path.is_symlink():
                st = path.stat()
                times[path] = (base_fingerprint(path), st.st_atime_ns, st.st_mtime_ns)
    return times


def base_is_xcodebuild(cmd):
    return Path(cmd[0]).name == "xcodebuild" or (len(cmd) > 1 and
           Path(cmd[0]).name == "xcrun" and cmd[1] == "xcodebuild")


def base_command(cmd, origin, src, derived):
    if not base_is_xcodebuild(cmd):
        return cmd
    if any(a == "-derivedDataPath" or a.startswith("-derivedDataPath=") for a in cmd):
        raise ValueError("--base owns DerivedData; remove -derivedDataPath and use --products-to for outputs")
    rewritten = []
    for arg in cmd:
        # Only argument values are mapped, never code inside a shell -c string.
        key, sep, value = arg.partition("=") if not os.path.isabs(arg) else ("", "", arg)
        path = value if sep else arg
        if os.path.isabs(path):
            try:
                path = str(src / Path(path).resolve().relative_to(origin))
            except ValueError:
                pass
        rewritten.append(key + sep + path if sep else path)
    return [*rewritten, "-derivedDataPath", str(derived)]


def base_check_products_settings(command, cwd, env, derived):
    """Do not export a stale default Products tree when Xcode actually builds elsewhere."""
    if not base_is_xcodebuild(command):
        return  # Custom commands explicitly own the contract of writing to BUILDQ_DERIVED_DATA.
    query = []
    args = iter(command)
    for arg in args:
        # A settings query must not create a result bundle the real command needs to create.
        if arg in ("-resultBundlePath", "-resultStreamPath", "-archivePath"):
            if next(args, None) is None:
                raise ValueError(f"missing value for {arg}")
        elif arg not in ("-showBuildSettings", "-json"):
            query.append(arg)
    result = base_exec([*query, "-showBuildSettings", "-json"], cwd, env, capture=True)
    if result.returncode:
        detail = result.stderr.decode(errors="replace").strip()
        raise ValueError(f"cannot verify product directories before export: {detail}")
    try:
        targets = json.loads(result.stdout)
    except ValueError:
        raise ValueError("cannot verify product directories: xcodebuild returned invalid build settings JSON") from None
    if not isinstance(targets, list) or not targets:
        raise ValueError("cannot verify product directories: xcodebuild returned no target settings")
    allowed = derived.resolve() / "Build" / "Products"
    for target in targets:
        settings = target.get("buildSettings") if isinstance(target, dict) else None
        if not isinstance(settings, dict):
            raise ValueError("cannot verify product directories: missing build settings")
        for key in ("BUILT_PRODUCTS_DIR", "TARGET_BUILD_DIR"):
            value = settings.get(key)
            if not isinstance(value, str) or not value:
                raise ValueError(f"cannot verify product directories: missing {key}")
            actual = (cwd / value).resolve()
            if not actual.is_relative_to(allowed):
                raise ValueError(f"--products-to cannot export products outside {allowed}: "
                                 f"{target.get('target', '?')} {key}={actual}; remove the product-directory "
                                 "override or omit --products-to and manage those products explicitly")


def base_path_spellings(path):
    # Xcode/DWARF may spell /private/var as /var (likewise /private/tmp as /tmp),
    # even when our checkout and cwd use the canonical path. LLDB must recognize both.
    value = str(path)
    spellings = {value}
    for prefix in ("/private/var/", "/private/tmp/"):
        if value.startswith(prefix):
            spellings.add(value[len("/private"):])
    return sorted(spellings)


def base_stream(cmd, cwd, env, src, origin):
    fd = int(os.environ["BUILDQ_BASE_LOCK_FD"])
    base_check_cancel()
    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, pass_fds=(fd,))
    # Map compiler diagnostics back to editable sources; generated files retain their real paths.
    prefixes = b"|".join(re.escape(os.fsencode(p)) for p in base_path_spellings(src))
    pattern = re.compile(rb"(?:" + prefixes + rb")(/[^\s:\"']+)")
    try:
        for line in proc.stdout:
            def mapped(match):
                path = os.fsencode(origin) + match[1]
                return path if os.path.exists(path) else match[0]
            sys.stdout.buffer.write(pattern.sub(mapped, line))
            sys.stdout.buffer.flush()
        code = proc.wait()
        base_check_cancel()
        return code if code >= 0 else 128 - code
    finally:
        proc.stdout.close()


def base_check_product_links(root):
    """Only relative links contained in the copied tree remain independent after publication."""
    canonical_root = root.resolve()
    for directory, dirs, files in os.walk(root, followlinks=False):
        base_check_cancel()
        for name in dirs + files:
            path = Path(directory) / name
            if not path.is_symlink():
                continue
            try:
                target = path.resolve(strict=True)
            except (OSError, RuntimeError):
                raise ValueError(f"invalid product symlink: {path.relative_to(root)}") from None
            if not target.is_relative_to(canonical_root):
                raise ValueError(f"product symlink points outside the export: {path.relative_to(root)}; "
                                 "build self-contained products before using --products-to")


def base_export(derived, destination, src, origin, env, dsym):
    products = derived / "Build" / "Products"
    if not products.is_dir():
        raise ValueError(f"no products to export at {products}")
    if products.resolve() != derived.resolve() / "Build" / "Products":
        raise ValueError("product directory redirects outside the base's Products tree")
    # Copy to a sibling staging folder and publish atomically; an interrupted export stays private.
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".buildq-products-", dir=destination.parent) as temp:
        stage = Path(temp) / "products"
        shutil.copytree(products, stage, symlinks=True)
        base_check_product_links(stage)
        base_check_cancel()
        if dsym:
            magic = {b"\xcf\xfa\xed\xfe", b"\xce\xfa\xed\xfe", b"\xfe\xed\xfa\xcf",
                     b"\xfe\xed\xfa\xce", b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"}
            binaries = []
            for directory, dirs, files in os.walk(stage):
                dirs[:] = [d for d in dirs if not d.endswith(".dSYM")]
                for name in files:
                    path = Path(directory) / name
                    if path.is_symlink():
                        continue
                    with path.open("rb") as f:
                        if f.read(4) in magic:
                            binaries.append(path)
            for binary in binaries:
                symbols = stage / "BuildQSymbols" / (str(binary.relative_to(stage)) + ".dSYM")
                symbols.parent.mkdir(parents=True, exist_ok=True)
                result = base_exec(["xcrun", "dsymutil", str(binary), "-o", str(symbols)], src, env)
                if result.returncode:
                    return result.returncode
                result = base_exec(["xcrun", "dwarfdump", "--uuid", str(symbols)], src, env, capture=True)
                if result.returncode:
                    raise ValueError("could not read exported dSYM UUIDs")
                resources = symbols / "Contents" / "Resources"
                resources.mkdir(parents=True, exist_ok=True)
                for uuid in re.findall(rb"UUID: ([0-9A-Fa-f-]+)", result.stdout):
                    with (resources / (uuid.decode() + ".plist")).open("wb") as f:
                        plistlib.dump({"DBGVersion": "3", "DBGSourcePathRemapping": {
                            spelling: str(origin) for spelling in base_path_spellings(src)}}, f)
        base_check_cancel()
        base_check_product_links(stage)
        if destination.exists() or destination.is_symlink():
            raise ValueError(f"--products-to must name a new directory: {destination}")
        os.rename(stage, destination)
    log(f"products exported to {destination}")
    return 0


def cmd_base_run(args):
    """Internal worker: preparation and all its descendants remain under the outer queue lock."""
    try:
        options = json.loads(args.settings)
        fd = int(os.environ["BUILDQ_BASE_LOCK_FD"])
        os.fstat(fd)
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, base_on_signal)
        origin, cwd = Path(options["origin"]), Path(options["cwd"])
        env = base_env()
        common = os.fsdecode(base_git(origin, env, "rev-parse", "--git-common-dir")).strip()
        common = (origin / common).resolve()
        identity = hashlib.sha256(os.fsencode(common)).hexdigest()[:16]
        directory = base_root() / identity / options["name"]
        src, derived = directory / "src", directory / "DerivedData"
        if directory == origin or directory.is_relative_to(origin):
            raise ValueError("build bases must live outside the source worktree; set BUILDQ_BASE_ROOT")
        destination = Path(options["products_to"]).resolve() if options["products_to"] else None
        if destination and (destination.exists() or destination.is_relative_to(directory)
                            or destination == origin or origin.is_relative_to(destination)):
            raise ValueError("--products-to must be a new directory outside the base and source parents")
        head = base_git(origin, env, "rev-parse", "HEAD").decode().strip()
        directory.mkdir(parents=True, exist_ok=True)
        state_path = directory / "state.json"
        state = json.loads(state_path.read_text()) if state_path.exists() else {}
        if not isinstance(state, dict) or not isinstance(state.get("files", []), list) or not all(
                isinstance(p, str) for p in state.get("files", [])):
            raise ValueError(f"invalid build base state: {state_path}")
        if state and state.get("repository") != str(common):
            raise ValueError("build base belongs to another repository")
        state.update(name=options["name"], repository=str(common), directory=str(directory))
        if not (src / ".git").exists():
            if src.exists():
                raise ValueError(f"base checkout is incomplete: {src}; remove it with git worktree remove")
            base_git(origin, env, "worktree", "add", "--detach", "--no-checkout", str(src), head)
        actual_common = os.fsdecode(base_git(src, env, "rev-parse", "--git-common-dir")).strip()
        if (src / actual_common).resolve() != common:
            raise ValueError("base checkout has an unexpected git common directory")
        changed, removed = base_sync(origin, src, state_path, state, head, env, options["include_ignored"])
        log(f"base {options['name']}: {changed} changed, {removed} removed; DerivedData: {derived}")
        event("base_synced", base=options["name"], worktree=str(origin), changed=changed,
              removed=removed, derived_data=str(derived))
        derived.mkdir(exist_ok=True)
        cache = directory / "cache"
        cache.mkdir(exist_ok=True)
        env.update(BUILDQ_BASE_DIR=str(directory), BUILDQ_WORKTREE=str(origin),
                   BUILDQ_DERIVED_DATA=str(derived), BUILDQ_BASE_CACHE=str(cache))
        command = base_command(args.cmd, origin, src, derived)
        for prepare in options["prepare"]:
            times = base_generated_times(src)
            code = base_stream(["/bin/sh", "-c", prepare], src, env, src, origin)
            for path, (fingerprint, atime, mtime) in times.items():
                if base_fingerprint(path) == fingerprint:
                    os.utime(path, ns=(atime, mtime))
            if code:
                return code
        build_cwd = base_path(src, str(cwd.relative_to(origin)))
        build_cwd.mkdir(parents=True, exist_ok=True)
        if destination:
            base_check_products_settings(command, build_cwd, env, derived)
        code = base_stream(command, build_cwd, env, src, origin)
        if code == 0 and destination:
            code = base_export(derived, destination, src, origin, env, options["dsym"])
        base_check_cancel()
        return code
    except BaseCancelled:
        return 128 + BASE_SIGNAL
    except OSError as e:
        print(f"error: build base: {e}", file=sys.stderr, flush=True)
        return 127 if isinstance(e, FileNotFoundError) and e.filename and not Path(e.filename).exists() else 1
    except (ValueError, KeyError) as e:
        print(f"error: build base: {e}", file=sys.stderr, flush=True)
        return 1


def cmd_bases(args):
    records = []
    for path in sorted(base_root().glob("*/*/state.json")):
        try:
            state = json.loads(path.read_text())
            if not isinstance(state, dict):
                continue
            records.append({k: state.get(k) for k in ("name", "repository", "directory", "worktree", "head", "updated")})
        except (OSError, ValueError):
            continue
    if args.json:
        print(json.dumps(records, ensure_ascii=False))
    else:
        for record in records:
            print(f"{record['name']}: {record['directory']} (last worktree: {record['worktree']})")
        if not records:
            print("no build bases")


ERROR_LINE = re.compile(r"(error:|\*\* .*FAILED \*\*|Testing failed|fatal error)", re.I)
LOCATED_ERROR = re.compile(r"^(?P<file>/[^:]+):(?P<line>\d+):(?:(?P<col>\d+):)?\s*(?:fatal )?error:\s*(?P<msg>.*)")
ERRORS_LIMIT = 40


def parse_errors(path):
    """Unique error lines of a build log; compiler diagnostics are split into file/line/col/msg."""
    try:
        lines = [l.rstrip() for l in open(path, errors="replace") if ERROR_LINE.search(l) and not l.startswith("# ")]
    except OSError:
        return []
    out = []
    for l in dict.fromkeys(lines):
        m = LOCATED_ERROR.match(l)
        if m:
            out.append({"file": m["file"], "line": int(m["line"]), "col": int(m["col"]) if m["col"] else None,
                        "msg": m["msg"]})
        else:
            out.append({"msg": l.strip()})
    return out


def format_error(e):
    if "file" not in e:
        return e["msg"]
    return f"{e['file']}:{e['line']}:{str(e['col']) + ':' if e['col'] else ''} error: {e['msg']}"


def print_errors(path, limit=ERRORS_LIMIT):
    errors = parse_errors(path)
    if errors:
        log(f"errors from {path}:")
        for e in errors[:limit]:
            print(format_error(e), file=sys.stderr)
        if len(errors) > limit:
            log(f"... {len(errors) - limit} more")


# ---------- status / cancel ----------

def cmd_status(args):
    ensure_dirs()
    reap()
    now = time.time()
    tickets = load_tickets()
    if args.json:
        print(json.dumps(tickets, indent=1))
        return
    if not tickets:
        print("queue is empty")
    for i, t in enumerate(tickets):
        if t["state"] in ("running", "orphan"):
            tag = "RUNNING " if t["state"] == "running" else "ORPHAN  "
            print(f"{tag} {describe(t)}  for {fmt_dur(now - t['started_at'])}  pid {t['pid']}"
                  + (f"  log {t['log'] or t['full_log']}" if t.get("full_log") else ""))
        else:
            print(f"#{i + 1:<7} {describe(t)}  waiting {fmt_dur(now - t['enqueued_ns'] / 1e9)}  pid {t['pid']}"
                  f"  id {t['id']}")
    if args.history and HISTORY.exists():
        print("\nrecent:")
        for line in HISTORY.read_text().splitlines()[-args.history:]:
            h = json.loads(line)
            print(f"  {h['finished_at']}  exit {h['exit']:<3} ran {fmt_dur(h['ran']):>7}  waited "
                  f"{fmt_dur(h['waited']):>7}  {Path(h['worktree']).name}  «{h['label']}»")


def cmd_events(args):
    if not EVENTS.exists():
        print("no events yet")
        return
    for line in EVENTS.read_text().splitlines()[-args.n:]:
        e = json.loads(line)
        if args.kind and e["kind"] not in args.kind.split(","):
            continue
        if args.json:
            print(line)
            continue
        rest = {k: v for k, v in e.items() if k not in ("ts", "kind", "pid")}
        wt = rest.pop("worktree", "")
        label = rest.pop("label", "")
        head = f"{e['ts']}  {e['kind']:<18} pid {e['pid']:<6} {Path(wt).name if wt else ''}"
        print(head + (f" «{label}»" if label else "") + ("  " + json.dumps(rest, ensure_ascii=False) if rest else ""))


def cmd_cancel(args):
    ensure_dirs()
    for t in load_tickets():
        if args.target in (t["id"], str(t["pid"])):
            os.kill(t["pid"], signal.SIGTERM)
            print(f"sent SIGTERM to {t['pid']} ({describe(t)})")
            return
    sys.exit(f"no ticket with id or pid {args.target}")


def cmd_priority(args):
    """Change the priority of a waiting build; it moves within the queue on its next poll."""
    ensure_dirs()
    reap()
    for t in load_tickets():
        if args.target in (t["id"], str(t["pid"])):
            old = t.get("priority", DEFAULT_PRIORITY)
            t["priority"] = args.level
            write_ticket(t)
            event("priority", ticket=t["id"], worktree=t["worktree"], label=t["label"], old=old, new=args.level)
            note = "" if t["state"] == "waiting" else f" (already {t['state']}, the order is unaffected)"
            print(f"{describe(t)}: {old} -> {args.level}{note}")
            return
    sys.exit(f"no ticket with id or pid {args.target}")


def history():
    out = []
    for path in (HISTORY.with_name(HISTORY.name + ".1"), HISTORY):
        try:
            out += [json.loads(l) for l in path.read_text().splitlines() if l.strip()]
        except (OSError, json.JSONDecodeError):
            continue
    return out


def find_build(target, any_worktree=False):
    """A queued/running ticket or a finished history record by id (a unique prefix is enough);
    without an id, this worktree's latest build."""
    builds = history() + [t for t in load_tickets() if t.get("full_log")]
    if target:
        hits = [b for b in builds if b["id"] == target] or [b for b in builds if b["id"].startswith(target)]
        if not hits:
            sys.exit(f"no build with id {target}")
        if len({b["id"] for b in hits}) > 1:
            sys.exit(f"{target} matches several builds: {', '.join(dict.fromkeys(b['id'] for b in hits))}")
        return hits[-1]
    if not any_worktree:
        wt = worktree_root()
        builds = [b for b in builds if b["worktree"] == wt]
    if not builds:
        sys.exit("no builds yet" + ("" if any_worktree else " in this worktree; --all looks at every worktree"))
    return builds[-1]


def cmd_errors(args):
    b = find_build(args.id, args.all)
    errors = parse_errors(b["full_log"])
    if args.json:
        print(json.dumps({"id": b["id"], "exit": b.get("exit"), "state": b.get("state", "finished"),
                          "log": b["full_log"], "errors": errors[:args.limit]}, ensure_ascii=False))
        return
    print(f"{b['id']}  exit {b.get('exit', b.get('state'))}  «{b['label']}»  {b['full_log']}")
    for e in errors[:args.limit]:
        print(format_error(e))
    if len(errors) > args.limit:
        print(f"... {len(errors) - args.limit} more")


def cmd_log(args):
    b = find_build(args.id, args.all)
    if args.path:
        print(b["full_log"])
        return
    try:
        with open(b["full_log"], errors="replace") as f:
            lines = f.readlines()
    except OSError as e:
        sys.exit(f"cannot read {b['full_log']}: {e}")
    sys.stdout.write("".join(lines[-args.tail:] if args.tail else lines))


# ---------- agent hook ----------

LIGHT_XCODEBUILD = re.compile(
    r"-(list|version|showsdks|showBuildSettings|showdestinations|showTestPlans|resolvePackageDependencies|help)\b"
    r"|\btest-without-building\b")
CMD_PREFIXES = {"env", "time", "nohup", "sudo", "xcrun", "caffeinate", "command", "exec"}
SEGMENT_SPLIT = re.compile(r"&&|\|\||[;|\n()`]|\$\(")


def normalize(segment):
    """`FOO=1 env xcrun /usr/bin/xcodebuild -x` -> `xcodebuild -x`, so patterns see the real tool."""
    words = segment.split()
    while words and (words[0] in CMD_PREFIXES or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0])
                     or words[0].startswith("-")):
        words.pop(0)
    return " ".join([os.path.basename(words[0])] + words[1:]) if words else ""


def heavy(segment, config):
    """Name of the heavy tool in this shell segment, or None."""
    cmd = normalize(segment)
    if not cmd:
        return None
    guard = config.get("guard", {})
    if guard.get("builtin", True):
        tool, _, rest = cmd.partition(" ")
        if tool == "xcodebuild" and not LIGHT_XCODEBUILD.search(rest):
            return "xcodebuild"
        m = re.match(r"tuist\s+(generate|build|test|install|cache)\b", cmd)
        if m:
            return m.group(0)
    for pat in guard.get("patterns", []):
        try:
            if re.search(pat, cmd):
                return cmd[:80]
        except re.error as e:
            log(f"bad guard pattern {pat!r} in {CONFIG}: {e}")
    return None


def check_command(cmd, config):
    if "buildq run" in cmd or "BUILDQ_BYPASS=1" in cmd:
        return None
    for seg in SEGMENT_SPLIT.split(cmd):
        hit = heavy(seg, config)
        if hit:
            return hit
    return None


def cmd_hook(_args):
    """Claude Code PreToolUse hook for Bash: heavy builds that bypass the queue are rewritten to go
    through it (guard.mode "rewrite", the default) or denied (guard.mode "deny")."""
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        return
    tool_input = data.get("tool_input") or {}
    cmd = tool_input.get("command") or ""
    config = load_config()
    hit = check_command(cmd, config)
    if not hit:
        return
    session = data.get("session_id", "")
    if config.get("guard", {}).get("mode", "rewrite") == "rewrite":
        wrapped = rewrite(cmd, hit)
        # No permissionDecision: the rewritten command still goes through the user's permission rules.
        print(json.dumps({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "updatedInput": {**tool_input, "command": wrapped, "run_in_background": True},
            "additionalContext": f"buildq moved `{hit}` into the shared build queue (other agents build in "
                                 f"parallel) and runs it in the background as: {wrapped}\nWait for the "
                                 f"completion notification. The build output stays in a log file (its path is "
                                 f"printed at the end); on failure the error lines are printed too. "
                                 f"`buildq log --tail 100` and `buildq errors` show the latest build of this "
                                 f"worktree, `buildq status` shows the queue."}}))
        event("hook_rewrite", worktree=data.get("cwd", ""), hit=hit, cmd=cmd[:300], session=session)
        return
    reason = (f"`{hit}` must go through the shared build queue: other agents build in parallel and "
              f"concurrent builds slow down or break each other. Re-run it as "
              f"`buildq run --label '<what>' --quiet -- <same command>` with run_in_background=true "
              f"and wait for the completion notification; `buildq status` shows the queue. For the app use "
              f"this worktree's own simulator: `buildq sim` prints its UDID.")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))
    event("hook_deny", worktree=data.get("cwd", ""), hit=hit, cmd=cmd[:300], session=session)


def rewrite(cmd, hit):
    """The whole command line runs inside the slot via the user's shell, so pipes, `cd`, `&&` and
    variable assignments keep working. Output is kept quiet unless the command already shapes it."""
    me = os.path.realpath(sys.argv[0])
    on_path = shutil.which("buildq")
    exe = "buildq" if on_path and os.path.realpath(on_path) == me else shlex.quote(me)
    quiet = "" if re.search(r"[|>]", cmd) else " --quiet"
    return f'{exe} run{quiet} --label {shlex.quote(hit)} -- "${{SHELL:-/bin/sh}}" -c {shlex.quote(cmd)}'


# ---------- sim ----------

def simctl(*a, check=True):
    r = subprocess.run(["xcrun", "simctl", *a], capture_output=True, text=True)
    if check and r.returncode != 0:
        sys.exit(f"simctl {' '.join(a)} failed: {r.stderr.strip()}")
    return r


def devices():
    data = json.loads(simctl("list", "devices", "-j").stdout)
    return [{**d, "runtime": rt} for rt, devs in data["devices"].items()
            for d in devs if d.get("isAvailable", True)]


def find(name=None, udid=None):
    for d in devices():
        if (name and d["name"] == name) or (udid and d["udid"] == udid):
            return d
    return None


def wait_state(udid, wanted, timeout=60):
    end = time.time() + timeout
    while time.time() < end:
        d = find(udid=udid)
        if d and d["state"] == wanted:
            return
        time.sleep(1)


def refresh_base(source=None):
    if source:
        dev = find(udid=source) or find(name=source)
        if not dev:
            sys.exit(f"no simulator with UDID or name {source!r} (see `xcrun simctl list devices`)")
        SIM_SOURCE_FILE.write_text(dev["udid"] + "\n")
    src = os.environ.get("BUILDQ_SIM_SOURCE") or (
        SIM_SOURCE_FILE.read_text().strip() if SIM_SOURCE_FILE.exists() else "")
    if not src or not find(udid=src):
        sys.exit("source simulator is not set or missing; run `buildq sim --refresh-base --source <UDID|name>`")
    old = find(name=BASE_SIM)
    if old:
        simctl("delete", old["udid"])
    was_booted = find(udid=src)["state"] == "Booted"
    if was_booted:
        log(f"shutting down source {src} to clone it")
        simctl("shutdown", src, check=False)
        wait_state(src, "Shutdown")
    try:
        udid = simctl("clone", src, BASE_SIM).stdout.strip()
    finally:
        if was_booted:
            simctl("boot", src, check=False)
    log(f"{BASE_SIM} = {udid} (clone of {src})")
    event("sim_base_refreshed", udid=udid, source=src, source_was_booted=was_booted)


def cmd_sim(args):
    ensure_dirs()
    lock_fd = os.open(SIM_LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    if args.refresh_base:
        refresh_base(args.source)
        return
    if args.list:
        for d in devices():
            if d["name"].startswith(SIM_PREFIX) or d["name"] == BASE_SIM:
                print(f"{d['udid']}  {d['state']:<9} {d['name']}")
        return
    name = args.name or SIM_PREFIX + Path(worktree_root()).name
    dev = find(name=name)
    if args.rm:
        if dev:
            simctl("shutdown", dev["udid"], check=False)
            simctl("delete", dev["udid"])
            log(f"deleted {name}")
            event("sim_deleted", name=name, udid=dev["udid"])
        return
    if not dev:
        base = find(name=BASE_SIM)
        if not base:
            event("sim_no_base", name=name, worktree=worktree_root())
            sys.exit(f"no {BASE_SIM}; ask the user to run `buildq sim --refresh-base` "
                     f"(briefly shuts down their main simulator)")
        if base["state"] != "Shutdown":
            simctl("shutdown", base["udid"], check=False)
            wait_state(base["udid"], "Shutdown")
        udid = simctl("clone", base["udid"], name).stdout.strip()
        log(f"created {name} = {udid} from {BASE_SIM}")
        event("sim_created", name=name, udid=udid, worktree=worktree_root())
        dev = find(udid=udid)
    if not args.no_boot and dev["state"] != "Booted":
        simctl("boot", dev["udid"], check=False)
        simctl("bootstatus", dev["udid"], check=False)
    print(dev["udid"])


def main():
    # Private worker entry point, invoked only after the queue lock has been acquired.
    if len(sys.argv) > 2 and sys.argv[1] == "_base-run":
        sys.exit(cmd_base_run(argparse.Namespace(settings=sys.argv[2], cmd=sys.argv[3:])))
    p = argparse.ArgumentParser(prog="buildq", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"buildq {__version__}")
    sub = p.add_subparsers(dest="sub", required=True)

    r = sub.add_parser("run", help="wait for the build slot, run the command, release the slot")
    r.add_argument("--label", help="short description shown in status")
    r.add_argument("--priority", choices=PRIORITIES,
                   help=f"queue priority (default: $BUILDQ_PRIORITY, then config rules, then {DEFAULT_PRIORITY})")
    r.add_argument("--log", help="write command output to this file (status lines stay on stderr; "
                                 "on failure the error lines are printed)")
    r.add_argument("--max-wait", type=float, default=120,
                   help="minutes to wait in queue, 0 = forever (default 120); exit 75 on timeout")
    r.add_argument("--report-every", type=float, default=60, help="seconds between waiting reports")
    r.add_argument("--quiet", action="store_true",
                   help="keep the command output in the log only; on failure print the error lines")
    r.add_argument("--json", action="store_true",
                   help="like --quiet, then print one JSON object: id, exit, waited, ran, log, errors")
    r.add_argument("--base", metavar="NAME", help="build in a reusable base shared by this repository's worktrees")
    r.add_argument("--prepare", action="append", default=[], metavar="COMMAND",
                   help="with --base: shell command to prepare the project before each build (repeatable)")
    r.add_argument("--include-ignored", action="append", default=[], metavar="PATHSPEC",
                   help="with --base: also mirror ignored files matching this git pathspec (repeatable)")
    r.add_argument("--products-to", metavar="DIR",
                   help="with --base: export successful products and dSYMs to a new directory")
    r.add_argument("--no-dsym", action="store_true", help="with --products-to: skip exporting debug symbols")
    r.add_argument("cmd", nargs=argparse.REMAINDER)
    r.set_defaults(func=cmd_run)

    s = sub.add_parser("status", help="show running and waiting builds")
    s.add_argument("--json", action="store_true")
    s.add_argument("--history", type=int, default=5, help="show N recent finished builds")
    s.set_defaults(func=cmd_status)

    b = sub.add_parser("bases", help="list reusable build bases and their paths")
    b.add_argument("--json", action="store_true")
    b.set_defaults(func=cmd_bases)

    for name, func, help_ in (("errors", cmd_errors, "error lines of a build (default: this worktree's latest)"),
                              ("log", cmd_log, "output of a build (default: this worktree's latest)")):
        x = sub.add_parser(name, help=help_)
        x.add_argument("id", nargs="?", help="ticket id or its unique prefix")
        x.add_argument("--all", action="store_true", help="latest build of any worktree")
        x.set_defaults(func=func)
        if name == "errors":
            x.add_argument("--json", action="store_true")
            x.add_argument("--limit", type=int, default=ERRORS_LIMIT)
        else:
            x.add_argument("--tail", type=int, default=0, help="only the last N lines")
            x.add_argument("--path", action="store_true", help="print the log path only")

    c = sub.add_parser("cancel", help="stop a queued or running build by ticket id or pid")
    c.add_argument("target")
    c.set_defaults(func=cmd_cancel)

    pr = sub.add_parser("priority", help="change the priority of a queued build by ticket id or pid")
    pr.add_argument("target")
    pr.add_argument("level", choices=PRIORITIES)
    pr.set_defaults(func=cmd_priority)

    e = sub.add_parser("events", help=f"show the event journal ({EVENTS})")
    e.add_argument("-n", type=int, default=50, help="last N events (default 50)")
    e.add_argument("--kind", help="comma-separated kinds: enqueued,acquired,finished,interrupted,"
                                  "timeout,priority,reaped,hook_deny,sim_*")
    e.add_argument("--json", action="store_true")
    e.set_defaults(func=cmd_events)

    m = sub.add_parser("sim", help="print UDID of this worktree's simulator, creating and booting it if needed")
    m.add_argument("--name", help=f"simulator name (default {SIM_PREFIX}<worktree dir>)")
    m.add_argument("--no-boot", action="store_true")
    m.add_argument("--rm", action="store_true", help="delete this worktree's simulator")
    m.add_argument("--list", action="store_true", help="list buildq simulators")
    m.add_argument("--refresh-base", action="store_true",
                   help=f"re-clone {BASE_SIM} from the source simulator (shuts it down briefly)")
    m.add_argument("--source", help="with --refresh-base: UDID or name of the simulator to clone (remembered)")
    m.set_defaults(func=cmd_sim)

    h = sub.add_parser("hook", help="Claude Code PreToolUse hook: reads the tool call JSON on stdin, "
                                    "denies heavy builds outside the queue")
    h.set_defaults(func=cmd_hook)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
